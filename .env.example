# Copy this file to .env and fill in your keys. .env is git-ignored.
ANTHROPIC_API_KEY=

# Voice mode (python main.py --voice)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Phone link: Discord bot token (discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Phone link: WhatsApp Business Cloud API (developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_OWNER_NUMBER=

# Camera security system (Hikvision DVR)
HIKVISION_HOST=192.168.100.191
HIKVISION_USERNAME=
HIKVISION_PASSWORD=
